+/-! ### The pinned system with one common denominator
+
+The bounds above treat every row of the pinned system as a row of height
+`fiberPinnedHeight` and every coordinate of its Cramer point as a separate fraction.
+`PinnedPoint.lean` uses that the commitment is an integer vector over one denominator of
+height `G`, solves the pinned system for the multiple of the point by that denominator,
+and keeps the common Cramer denominator. This gives the following smaller caps. -/
+
+/-- Common numerator and denominator bound for the Cramer point of the pinned system:
+clipping rows of height `H` are cleared to `H^(s+2)`, and the commitment height `G`
+enters once, through the right-hand side. -/
+def pinnedPointCap (s H G : ℕ) : ℕ := (s+1).factorial * (H^(s+2))^(s+1) * G
+
+/-- Bound for an affine evaluation, with coefficients of height `C`, of a point whose
+coordinates have numerators and one common denominator of height `Y`. -/
+def pinnedValueCap (s C Y : ℕ) : ℕ := (s+1) * (C+1)^(s+2) * Y
+
+theorem pinnedPointCap_mono {s t H G : ℕ} (hst : s ≤ t) (hH : 0 < H) :
+    pinnedPointCap s H G ≤ pinnedPointCap t H G := by
+  unfold pinnedPointCap
+  apply Nat.mul_le_mul_right
+  apply Nat.mul_le_mul (Nat.factorial_le (Nat.succ_le_succ hst))
+  calc
+    _ ≤ (H^(t+2))^(s+1) :=
+      Nat.pow_le_pow_left (Nat.pow_le_pow_right hH (Nat.add_le_add_right hst 2)) _
+    _ ≤ _ := Nat.pow_le_pow_right (Nat.pow_pos hH) (Nat.succ_le_succ hst)
+
+theorem pinnedPointCap_le_two_pow (s : ℕ) {H G L c : ℕ} (hH : H ≤ 2^L) (hG : G ≤ 2^c) :
+    pinnedPointCap s H G ≤ 2^((s+1)*(s+1) + L*(s+2)*(s+1) + c) := by
+  have hf : (s+1).factorial ≤ (2^(s+1))^(s+1) :=
+    (Nat.factorial_le_pow (s+1)).trans (Nat.pow_le_pow_left (s+1).lt_two_pow_self.le (s+1))
+  unfold pinnedPointCap
+  calc
+    _ ≤ (2^(s+1))^(s+1) * ((2^L)^(s+2))^(s+1) * 2^c :=
+      Nat.mul_le_mul (Nat.mul_le_mul hf (Nat.pow_le_pow_left (Nat.pow_le_pow_left hH _) _)) hG
+    _ = _ := by rw [← pow_mul, ← pow_mul, ← pow_mul, ← pow_add, ← pow_add, Nat.mul_assoc]
+
+/-- Exponent for the common-denominator point of the pinned system. The commitment
+exponent enters once, not once per variable and per cleared entry. -/
+def pinnedPointBits (k width dim L : ℕ) : ℕ :=
+  (dim+1)*(dim+1) + L*(dim+2)*(dim+1) + fiberCommitBits k width L
+
+theorem pinnedPointHeight_le_two_pow (k width dim H L : ℕ) (hH : H ≤ 2^L) :
+    pinnedPointCap dim H (fiberCommitCap k ((k+1)*fiberProjectionBudget k width H+1)) ≤
+      2^pinnedPointBits k width dim L :=
+  pinnedPointCap_le_two_pow dim hH (fiberCommitCap_budget_le_two_pow k width H L hH)
+
+/-- Exponent for an affine minor value at the common-denominator point, on coefficients
+of height at most `2^A`. The point exponent enters once. -/
+def pinnedValueBits (k width dim L A : ℕ) : ℕ :=
+  dim+1 + (A+1)*(dim+2) + pinnedPointBits k width dim L
+
+theorem pinnedValueHeight_le_two_pow (k width dim H L C A : ℕ) (hH : H ≤ 2^L) (hC : C ≤ 2^A) :
+    pinnedValueCap dim C
+        (pinnedPointCap dim H (fiberCommitCap k ((k+1)*fiberProjectionBudget k width H+1))) ≤
+      2^pinnedValueBits k width dim L A := by
+  unfold pinnedValueCap pinnedValueBits
+  rw [pow_add 2 _ (pinnedPointBits k width dim L), pow_add 2 (dim+1) _, pow_mul 2 (A+1) _]
+  exact Nat.mul_le_mul (Nat.mul_le_mul (dim+1).lt_two_pow_self.le
+    (Nat.pow_le_pow_left (succ_le_next_two_pow hC) _))
+    (pinnedPointHeight_le_two_pow k width dim H L hH)

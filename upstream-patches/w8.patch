+/-- The determinant with one column replaced by a vector of a different height: the
+expansion along that column (through the adjugate) is linear in the new height. -/
+theorem det_updateCol_natAbs_le {ι : Type*} [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ)
+    (b : ι → ℤ) {B B' : ℕ} (hB : 1 ≤ B) (hA : ∀ i j, (A i j).natAbs ≤ B)
+    (hb : ∀ i, (b i).natAbs ≤ B') (i : ι) :
+    (A.updateCol i b).det.natAbs ≤
+      Fintype.card ι * ((Fintype.card ι).factorial * B ^ Fintype.card ι * B') := by
+  have hadj (j : ι) :
+      (A.adjugate i j).natAbs ≤ (Fintype.card ι).factorial * B ^ Fintype.card ι := by
+    rw [Matrix.adjugate_apply]
+    apply det_natAbs_le_factorial_mul_pow
+    intro k l
+    rw [Matrix.updateRow_apply]
+    split_ifs
+    · rw [Pi.single_apply]
+      split_ifs
+      · simpa using hB
+      · simp
+    · exact hA k l
+  have hdet : (A.updateCol i b).det = ∑ j, A.adjugate i j * b j := by
+    rw [← Matrix.cramer_apply, Matrix.cramer_eq_adjugate_mulVec]
+    rfl
+  rw [hdet]
+  calc
+    _ ≤ ∑ j, (A.adjugate i j * b j).natAbs := Int.natAbs_sum_le _ _
+    _ ≤ ∑ _j : ι, (Fintype.card ι).factorial * B ^ Fintype.card ι * B' :=
+      Finset.sum_le_sum fun j _ => by
+        rw [Int.natAbs_mul]
+        exact Nat.mul_le_mul (hadj j) (hb j)
+    _ = _ := by simp
+
+/-- Cramer's rule for a nonsingular square system whose rows clear to height `T` with

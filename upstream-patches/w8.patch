+  have hQq : (Q : ℚ) ≠ 0 := by exact_mod_cast hQ
+  have hDq : (D : ℚ) ≠ 0 := by exact_mod_cast hD.ne'
+  have hDQ : (D : ℤ) * Q ≠ 0 := mul_ne_zero (by exact_mod_cast hD.ne') hQ
+  have hsum : (∑ j, F.coefficient u j * ((n j : ℚ) / (Q : ℚ))) * ((D : ℚ) * (Q : ℚ)) =
+      ∑ j, (a j : ℚ) * (n j : ℚ) := by
+    rw [Finset.sum_mul]
+    refine Finset.sum_congr rfl fun j _ => ?_
+    rw [(ha j).1]
+    field_simp
+  have heq : F.evalRat (fun j => (n j : ℚ) / (Q : ℚ)) u =
+      (P : ℚ) / (((D : ℤ) * Q : ℤ) : ℚ) := by
+    rw [eq_div_iff (by exact_mod_cast hDQ)]
+    simp only [AffineFamily.evalRat, P]
+    push_cast
+    rw [add_mul, hsum, h₀]
+    ring

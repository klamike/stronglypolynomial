+namespace Optimization
+namespace LinearProgramming
+namespace Compression
+
+open scoped BigOperators Matrix
+
+/-- A rational row `v` with constant `c` has a positive integer multiple whose entries
+are integers of magnitude at most `T`, and whose constant becomes an integer of
+magnitude at most `T'` after multiplication by the common denominator `q`. -/
+def RowClears {ι : Type*} (T T' : ℕ) (q : ℤ) (v : ι → ℚ) (c : ℚ) : Prop :=
+  ∃ (D : ℕ) (a : ι → ℤ) (R : ℤ), 0 < D ∧
+    (∀ j, (a j : ℚ) = (D : ℚ) * v j ∧ (a j).natAbs ≤ T) ∧
+    (R : ℚ) = (D : ℚ) * c * (q : ℚ) ∧ R.natAbs ≤ T'
+
+theorem RowClears.mono {ι : Type*} {T₁ T₂ T₁' T₂' : ℕ} {q : ℤ} {v : ι → ℚ} {c : ℚ}
+    (h : RowClears T₁ T₁' q v c) (hT : T₁ ≤ T₂) (hT' : T₁' ≤ T₂') : RowClears T₂ T₂' q v c := by
+  obtain ⟨D, a, R, hD, ha, hR, hb⟩ := h
+  exact ⟨D, a, R, hD, fun j => ⟨(ha j).1, (ha j).2.trans hT⟩, hR, hb.trans hT'⟩
+
+/-- A row of height `B` in `card ι` variables clears to height `B ^ (card ι + 2)`; its
+constant picks up the factor `q`. -/
+theorem rowClears_of_height {ι : Type*} [Fintype ι] (v : ι → ℚ) (c : ℚ) {B G : ℕ} (q : ℤ)
+    (hv : ∀ j, (v j).num.natAbs ≤ B ∧ (v j).den ≤ B) (hc : c.num.natAbs ≤ B ∧ c.den ≤ B)
+    (hq : q.natAbs ≤ G) :
+    RowClears (B ^ (Fintype.card ι + 2)) (B ^ (Fintype.card ι + 2) * G) q v c := by
+  classical
+  let row : Option ι → ℚ := fun j => j.elim c v
+  have hrow (j : Option ι) : (row j).num.natAbs ≤ B ∧ (row j).den ≤ B := by
+    cases j with
+    | none => exact hc
+    | some k => exact hv k
+  obtain ⟨D, a, hD, _, ha⟩ :=
+    clear_bounded_row row (fun j => (hrow j).1) (fun j => (hrow j).2)
+  have h₀ : (a none).natAbs ≤ B ^ (Fintype.card ι + 2) := by
+    simpa only [Fintype.card_option, Nat.add_assoc] using (ha none).2
+  refine ⟨D, fun j => a (some j), a none * q, hD, fun j => ⟨(ha (some j)).1, ?_⟩, ?_, ?_⟩
+  · simpa only [Fintype.card_option, Nat.add_assoc] using (ha (some j)).2
+  · rw [Int.cast_mul, (ha none).1]
+    rfl
+  · rw [Int.natAbs_mul]
+    exact Nat.mul_le_mul h₀ hq
+
+/-- A row with coefficients `0, ±1` whose constant is an integer over `q` needs no
+clearing. -/
+theorem rowClears_of_unit {ι : Type*} (v : ι → ℚ) (c : ℚ) {G : ℕ} (q z : ℤ) (hq : q ≠ 0)
+    (hv : ∀ j, (v j).num.natAbs ≤ 1 ∧ (v j).den ≤ 1) (hc : c = (z : ℚ) / (q : ℚ))
+    (hz : z.natAbs ≤ G) : RowClears 1 G q v c := by
+  have hqq : (q : ℚ) ≠ 0 := by exact_mod_cast hq
+  refine ⟨1, fun j => (v j).num, z, Nat.one_pos, fun j => ⟨?_, (hv j).1⟩, ?_, hz⟩
+  · have hden : (v j).den = 1 := le_antisymm (hv j).2 (v j).den_pos
+    rw [(Rat.den_eq_one_iff _).mp hden, Nat.cast_one, one_mul]
+  · rw [hc, Nat.cast_one, one_mul, div_mul_cancel₀ _ hqq]

+  let a₀ : ℤ := c none
+  have ha (j : κ) : (a j : ℚ) = (D : ℚ) * F.coefficient u j ∧ (a j).natAbs ≤ C ^ (k + 2) :=
+    ⟨(hcl (some j)).1,
+      by simpa only [Fintype.card_option, Nat.add_assoc] using (hcl (some j)).2⟩
+  have h₀ : (a₀ : ℚ) = (D : ℚ) * F.offset u := (hcl none).1
+  have hb₀ : a₀.natAbs ≤ C ^ (k + 2) := by
+    simpa only [Fintype.card_option, Nat.add_assoc] using (hcl none).2

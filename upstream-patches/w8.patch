+  rw [heq]
+  refine ⟨hred.1.trans (hP.trans hcap), hred.2.trans ?_⟩
+  rw [Int.natAbs_mul, Int.natAbs_natCast]
+  calc
+    D * Q.natAbs ≤ C ^ (k + 2) * Y := Nat.mul_le_mul hDT hQY
+    _ ≤ (k + 1) * (C ^ (k + 2) * Y) := Nat.le_mul_of_pos_left _ (Nat.succ_pos k)
+    _ ≤ _ := hcap

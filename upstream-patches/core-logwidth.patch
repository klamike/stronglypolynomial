+/-! ### Logarithmic width
+
+The sharper first conjunct of `minorProxy_independent_bound_all` bounds dissociated sets by
+`(7N²+8)·log₂(N+1)`; with `Nat.size N` (the binary length of `N`) as an integer upper bound for
+the logarithm this gives a width of order `N² log N` instead of `N³`. -/
+
+/-- Integer width bound `(7N²+8)·⌈log₂(N+1)⌉ + 1`, where `Nat.size N = ⌈log₂(N+1)⌉`. -/
+def logWidth (N : ℕ) : ℕ := (7*N^2+8) * Nat.size N + 1
+
+/-- The logarithmic width never exceeds the polynomial width. -/
+theorem logWidth_le_paperWidth (N : ℕ) : logWidth N ≤ paperWidth N := by
+  have hs : Nat.size N ≤ N := Nat.size_le.mpr N.lt_two_pow_self
+  unfold logWidth paperWidth
+  gcongr
+
+theorem logb_succ_le_size (N : ℕ) : Real.logb 2 ((N:ℝ)+1) ≤ (Nat.size N : ℝ) := by
+  have hr2 : (N:ℝ) + 1 ≤ (2:ℝ)^(Nat.size N) := by exact_mod_cast Nat.lt_size_self N
+  have hl := Real.logb_le_logb_of_le (by norm_num : (1:ℝ) < 2) (by positivity) hr2
+  rwa [Real.logb_pow, Real.logb_self_eq_one (by norm_num : (1:ℝ) < 2), mul_one] at hl
+
+/-- Dissociated sets of minor proxies have at most `logWidth N` elements. -/
+theorem minorProxy_independent_card_le_logWidth (fuel : ℕ) (hr : rD+rE=N)
+    (J : Finset (NonzeroPairMinor D E)) (hJ : IsDissociated (minorProxy D E fuel) J) :
+    J.card ≤ logWidth N := by
+  have h := (minorProxy_independent_bound_all D E fuel hr J hJ).1
+  have hc : (J.card : ℝ) ≤ (7*(N:ℝ)^2+8)*(Nat.size N : ℝ) :=
+    h.trans (mul_le_mul_of_nonneg_left (logb_succ_le_size N) (by positivity))
+  unfold logWidth
+  have hcast : (J.card : ℝ) ≤ (((7*N^2+8)*Nat.size N+1 : ℕ) : ℝ) := by push_cast; linarith
+  exact_mod_cast hcast
+

+by the resulting denominator, so the retained dimension does not enter the height. -/
+theorem exists_integer_projection_system_of_unit (G : Matrix ι κ ℚ) (H : Matrix ι (Fin d) ℚ)
+    (c : ι → ℚ) {B : ℕ} (hB : 1 ≤ B)
+    (hG : ∀ i j, (G i j).num.natAbs ≤ 1 ∧ (G i j).den ≤ 1)
+    (hH : ∀ i j, (H i j).num.natAbs ≤ B ∧ (H i j).den ≤ B)
+    (hc : ∀ i, (c i).num.natAbs ≤ B ∧ (c i).den ≤ B) :
+    ∃ (G' : Matrix ι κ ℤ) (H' : Matrix ι (Fin d) ℤ) (c' : ι → ℤ),
+      (∀ i j, (G' i j).natAbs ≤ fiberClearedRowBound d B) ∧
+      (∀ i j, (H' i j).natAbs ≤ fiberClearedRowBound d B) ∧
+      (∀ i, (c' i).natAbs ≤ fiberClearedRowBound d B) ∧
+      ∀ (x : κ → ℝ) (y : Fin d → ℝ),
+        (H.map (Rat.cast : ℚ → ℝ) *ᵥ y ≤ (fun i => (c i : ℝ)) - G.map (Rat.cast : ℚ → ℝ) *ᵥ x) ↔
+        H'.map (Int.cast : ℤ → ℝ) *ᵥ y ≤ (fun i => (c' i : ℝ)) - G'.map (Int.cast : ℤ → ℝ) *ᵥ x := by
+  classical
+  let row (i : ι) : Option (Fin d) → ℚ := fun j => j.elim (c i) (H i)
+  have hrow (i : ι) (j : Option (Fin d)) :
+      (row i j).num.natAbs ≤ B ∧ (row i j).den ≤ B := by
+    obtain _ | j := j
+    · exact hc i
+    · exact hH i j
+  choose D a hD hDB ha using fun i =>
+    clear_bounded_row (row i) (fun j => (hrow i j).1) (fun j => (hrow i j).2)
+  let G' : Matrix ι κ ℤ := fun i j => (D i : ℤ) * (G i j).num
+  let H' : Matrix ι (Fin d) ℤ := fun i j => a i (some j)
+  let c' := fun i => a i none
+  have hGq (i : ι) (j : κ) : (G' i j : ℚ) = (D i : ℚ) * G i j := by
+    have hden : (G i j).den = 1 := le_antisymm (hG i j).2 (G i j).den_pos
+    have hnum : ((G i j).num : ℚ) = G i j := (Rat.den_eq_one_iff _).mp hden
+    simp only [G', Int.cast_mul, Int.cast_natCast, hnum]
+  have bound (i : ι) (j : Option (Fin d)) : (a i j).natAbs ≤ fiberClearedRowBound d B := by
+    simpa [fiberClearedRowBound, Nat.add_assoc] using (ha i j).2
+  have boundG (i : ι) (j : κ) : (G' i j).natAbs ≤ fiberClearedRowBound d B := by
+    have h1 : (G' i j).natAbs ≤ D i := by
+      simp only [G', Int.natAbs_mul, Int.natAbs_natCast]
+      exact (Nat.mul_le_mul_left _ (hG i j).1).trans_eq (Nat.mul_one _)
+    have h2 : D i ≤ B ^ (d + 1) := by simpa using hDB i
+    exact h1.trans (h2.trans (Nat.pow_le_pow_right hB (by omega)))
+  refine ⟨G', H', c', boundG, (fun i j => bound i (some j)), (fun i => bound i none), ?_⟩
+  intro x y
+  change (∀ i, (∑ j, (H i j : ℝ) * y j) ≤ (c i : ℝ) - ∑ j, (G i j : ℝ) * x j) ↔
+    ∀ i, (∑ j, (H' i j : ℝ) * y j) ≤ (c' i : ℝ) - ∑ j, (G' i j : ℝ) * x j
+  apply forall_congr'
+  intro i
+  have hG' := sum_scaled_coefficients (G i) (G' i) (D i) (fun j => hGq i j) x
+  have hH' := sum_scaled_coefficients (H i) (H' i) (D i) (fun j => (ha i (some j)).1) y
+  have hc' : (c' i : ℝ) = (D i : ℝ) * (c i : ℝ) := by
+    exact_mod_cast (show (c' i : ℚ) = (D i : ℚ) * c i from (ha i none).1)
+  rw [hG', hH', hc', ← mul_sub]
+  exact (mul_le_mul_iff_right₀ (show (0 : ℝ) < D i by exact_mod_cast hD i)).symm
+
+private theorem integer_projection_presentation_of_unit {ν : Type*} [Fintype ν]
+    (G : Matrix ι κ ℚ) (H : Matrix ι ν ℚ) (c : ι → ℚ) {B : ℕ} (hB : 1 ≤ B)
+    (hG : ∀ i j, (G i j).num.natAbs ≤ 1 ∧ (G i j).den ≤ 1)
+    (hH : ∀ i j, (H i j).num.natAbs ≤ B ∧ (H i j).den ≤ B)
+    (hc : ∀ i, (c i).num.natAbs ≤ B ∧ (c i).den ≤ B) :
+    ∃ (G' : Matrix ι κ ℤ) (H' : Matrix ι (Fin (Fintype.card ν)) ℤ) (c' : ι → ℤ),
+      (∀ i j, (G' i j).natAbs ≤ fiberClearedRowBound (Fintype.card ν) B) ∧
+      (∀ i j, (H' i j).natAbs ≤ fiberClearedRowBound (Fintype.card ν) B) ∧
+      (∀ i, (c' i).natAbs ≤ fiberClearedRowBound (Fintype.card ν) B) ∧
+      ∀ x : κ → ℝ, (∃ y, H.map (Rat.cast : ℚ → ℝ) *ᵥ y ≤
+          (fun i => (c i : ℝ)) - G.map (Rat.cast : ℚ → ℝ) *ᵥ x) ↔
+        ∃ y, H'.map (Int.cast : ℤ → ℝ) *ᵥ y ≤
+          (fun i => (c' i : ℝ)) - G'.map (Int.cast : ℤ → ℝ) *ᵥ x := by
+  classical
+  let e := Fintype.equivFin ν
+  let Hf : Matrix ι (Fin (Fintype.card ν)) ℚ := H.submatrix id e.symm
+  have remap (v : ν → ℝ) :
+      Hf.map (Rat.cast : ℚ → ℝ) *ᵥ (v ∘ e.symm) = H.map (Rat.cast : ℚ → ℝ) *ᵥ v := by
+    funext i
+    exact e.symm.sum_comp (fun j => (H i j : ℝ) * v j)
+  obtain ⟨G', H', c', hGI, hHI, hcI, hequiv⟩ :=
+    exists_integer_projection_system_of_unit G Hf c hB hG (fun i j => hH i (e.symm j)) hc
+  refine ⟨G', H', c', hGI, hHI, hcI, fun x => ⟨?_, ?_⟩⟩
+  · rintro ⟨y, hy⟩
+    exact ⟨y ∘ e.symm, (hequiv x (y ∘ e.symm)).mp ((remap y).symm ▸ hy)⟩
+  · rintro ⟨z, hz⟩
+    refine ⟨z ∘ e, ?_⟩
+    rw [← remap (z ∘ e)]
+    simpa [Function.comp_def] using (hequiv x z).mpr hz
+
+/-- The projection theorem for systems whose retained columns are integral with entries
+`0, ±1` (the fiber system of the committed generators): the tests that must be preserved
+have a height independent of the number of retained coordinates. -/
+theorem rational_projection_of_preserving_affine_tests_of_unit [Fintype ι] {ν : Type*}
+    [Fintype ν] (G : Matrix ι κ ℚ) (H : Matrix ι ν ℚ) (c : ι → ℚ) {B : ℕ} (hB : 1 ≤ B)
+    (hG : ∀ i j, (G i j).num.natAbs ≤ 1 ∧ (G i j).den ≤ 1)
+    (hH : ∀ i j, (H i j).num.natAbs ≤ B ∧ (H i j).den ≤ B)
+    (hc : ∀ i, (c i).num.natAbs ≤ B ∧ (c i).den ≤ B) {x x' : κ → ℝ}
+    (hx : ∃ y, H.map (Rat.cast : ℚ → ℝ) *ᵥ y ≤
+      (fun i => (c i : ℝ)) - G.map (Rat.cast : ℚ → ℝ) *ᵥ x)
+    (tests : ∀ (a : κ → ℤ) (b : ℤ), (∀ j, (a j).natAbs ≤
+        projectionCoefficientBound (Fintype.card ν)
+          (fiberClearedRowBound (Fintype.card ν) B)) →
+      b.natAbs ≤ projectionCoefficientBound (Fintype.card ν)
+        (fiberClearedRowBound (Fintype.card ν) B) →
+      (∑ j, (a j : ℝ) * x j) ≤ b → (∑ j, (a j : ℝ) * x' j) ≤ b) :
+    ∃ y, H.map (Rat.cast : ℚ → ℝ) *ᵥ y ≤
+      (fun i => (c i : ℝ)) - G.map (Rat.cast : ℚ → ℝ) *ᵥ x' := by
+  obtain ⟨G', H', c', hGI, hHI, hcI, hequiv⟩ :=
+    integer_projection_presentation_of_unit G H c hB hG hH hc
   exact (hequiv x').mpr <| projection_of_preserving_affine_tests G' H' c' hGI hHI hcI
     ((hequiv x).mp hx) tests
 

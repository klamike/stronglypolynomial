+    (Nat.pow_le_pow_left (Nat.le_succ C) _).trans
+      (Nat.pow_le_pow_right (Nat.succ_pos C) (Nat.add_le_add_right hs 2))
+  have hP : P.natAbs ≤ (k + 1) * (C ^ (k + 2) * Y) := by
+    calc
+      P.natAbs ≤ (a₀ * Q).natAbs + (∑ j, a j * n j).natAbs := Int.natAbs_add_le _ _

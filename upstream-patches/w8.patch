+/-- The commitment of `exists_bounded_projection_commit` with its integer presentation:
+it is obtained by dividing an integer vector by its last coordinate, so the coordinates
+are integers over one positive integer, all strictly below the height bound. -/
+theorem exists_bounded_projection_commit_common {κ : Type*} [Fintype κ] (x : κ → ℝ) (Q : ℕ) :
+    ∃ γ : κ → ℚ,
+      (∀ i, (γ i).num.natAbs < commitHeight (Fintype.card κ) ((Fintype.card κ+1)*Q+1) ∧
+        (γ i).den < commitHeight (Fintype.card κ) ((Fintype.card κ+1)*Q+1)) ∧
+      (∀ (a : κ → ℤ) (b : ℤ), (∀ i, (a i).natAbs ≤ Q) → b.natAbs ≤ Q →
+        (∑ i, (a i : ℝ) * x i) ≤ b → (∑ i, (a i : ℝ) * (γ i : ℝ)) ≤ b) ∧
+      ∃ (q : ℤ) (z : κ → ℤ), 0 < q ∧
+        q.natAbs < commitHeight (Fintype.card κ) ((Fintype.card κ+1)*Q+1) ∧
+        ∀ i, (z i).natAbs < commitHeight (Fintype.card κ) ((Fintype.card κ+1)*Q+1) ∧
+          γ i = (z i : ℚ) / (q : ℚ) := by
+  classical
+  let e := Fintype.equivFin κ
+  let M := (Fintype.card κ + 1) * Q + 1
+  have hM : 0 < M := Nat.succ_pos _
+  obtain ⟨z, hzb, hz⟩ := Lattice.exists_bounded_sign_representative
+    (Nat.succ_pos (Fintype.card κ)) hM (Fin.snoc (fun i => x (e.symm i)) (1 : ℝ))
+  obtain ⟨hq, hb, _, hγ⟩ := normalizeCommit_spec (fun i => x (e.symm i)) hM z hzb hz
+  have hnat (i : Fin (Fintype.card κ + 1)) :
+      (z i).natAbs < commitHeight (Fintype.card κ) M := by
+    have h : ((z i).natAbs : ℤ) < (commitHeight (Fintype.card κ) M : ℤ) := by
+      simpa [commitHeight, Int.natCast_natAbs] using hzb i
+    exact_mod_cast h
+  exact ⟨fun i => normalizeCommit z (e i), fun i => hb (e i),
+    projection_tests_of_requestSigns e x _ Q hγ,
+    z (Fin.last _), fun i => z (e i).castSucc, hq, hnat _, fun i => ⟨hnat _, rfl⟩⟩
+

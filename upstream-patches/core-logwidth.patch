+/-- The bit formula `onlineMinorBitFormula` with the width bound on generator sets as a
+parameter instead of the fixed polynomial `(7*N^2+8)*N+1`. -/
+def onlineMinorBitFormulaW (w N : ℕ) : ℕ :=
+  let B := 100*(N+1)^3
+  let a := (2*w+B+14)+B+8
+  let L := ((B+17)+(2+a)+1)+((B+7)+a*4)
+  let n := w+1
+  let u := L*(w+w+2)
+  let cuts := w+1+(n+((n*n+(n+u*2)*n)*2+u))
+  let m := w+1+cuts+1
+  let commitment := fiberCommitCapFormula w m
+  let pinned := L+commitment+2
+  let point := w*w+pinned*(w+2)*w
+  w+1+((a+1)+(point+1))*(w+2)
+
+theorem onlineMinorBitFormula_eq_W (N : ℕ) :
+    onlineMinorBitFormula N = onlineMinorBitFormulaW ((7*N^2+8)*N+1) N := rfl
+
+theorem onlineMinorBitPolynomial_eval_eq_W (N : ℕ) :
+    onlineMinorBitPolynomial.eval N = onlineMinorBitFormulaW ((7*N^2+8)*N+1) N :=
+  onlineMinorBitPolynomial_eval N
+
+/-- The width-parametric exponent is monotone in the width. -/
+theorem onlineMinorBitFormulaW_mono {w w' : ℕ} (N : ℕ) (hw : w ≤ w') :
+    onlineMinorBitFormulaW w N ≤ onlineMinorBitFormulaW w' N := by
+  unfold onlineMinorBitFormulaW fiberCommitCapFormula
+  dsimp only
+  gcongr
+
+/-- Width-generic form of `fiber_manuscript_value_height`: any bound `width` on the number
+of committed coordinates and on the completion dimension gives the output bound
+`2^(onlineMinorBitFormulaW width N)`. -/
+theorem fiber_value_height_W (width N k dim : ℕ) (hk : k ≤ width) (hd : dim ≤ width) :
+    let B := 100*(N+1)^3
+    let E := (2:ℕ)^(B+7)
+    let C := max (requestCutoff (k+1)*E) (2*E)
+    let H := (B+17+4*C)*(E*C^4)
+    offlineValueCap dim C (offlinePointCap dim (fiberPinnedHeight k width H)) ≤
+      2^(onlineMinorBitFormulaW width N) :=
+  fiber_uniform_value_height_le_two_pow _ _ _ _ _ _ hk hd (fiber_request_height_le_two_pow hk)
+
